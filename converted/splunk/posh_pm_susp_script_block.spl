# Suspicious PowerShell In-Memory Script Block Execution - ATT&CK: T1059.001
index=windows (ScriptBlockText="*Net.WebClient*" OR ScriptBlockText="*DownloadString*" OR ScriptBlockText="*DownloadFile*" OR ScriptBlockText="*DownloadData*" OR ScriptBlockText="*Invoke-WebRequest*" OR ScriptBlockText="*iwr*" OR ScriptBlockText="*Start-BitsTransfer*" OR ScriptBlockText="*FromBase64String*") (ScriptBlockText="*IEX*" OR ScriptBlockText="*Invoke-Expression*" OR ScriptBlockText="*[System.Reflection.Assembly]::Load*" OR ScriptBlockText="*GetString*") (ScriptBlockText="*AmsiUtils*" OR ScriptBlockText="*amsiInitFailed*" OR ScriptBlockText="*AmsiScanBuffer*" OR ScriptBlockText="*amsiContext*") NOT (ScriptBlockText="*Chocolatey*" OR ScriptBlockText="*Install-PackageProvider*") | table _time, host, user, Image, CommandLine