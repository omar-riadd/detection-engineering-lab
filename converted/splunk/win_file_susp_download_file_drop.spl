# Suspicious File Drop in User Downloads or Staging Directory - ATT&CK: T1566.001
index=windows (TargetFilename="*\Downloads\*" OR TargetFilename="*\AppData\Local\Temp\*") (TargetFilename="*.vbs" OR TargetFilename="*.js" OR TargetFilename="*.hta" OR TargetFilename="*.lnk" OR TargetFilename="*.iso" OR TargetFilename="*.ps1" OR TargetFilename="*.exe") (Image="*\OUTLOOK.EXE" OR Image="*\thunderbird.exe" OR Image="*\chrome.exe" OR Image="*\msedge.exe" OR Image="*\firefox.exe" OR Image="*\winrar.exe" OR Image="*\7zFM.exe" OR Image="*\powershell.exe" OR Image="*\cmd.exe" OR Image="*\certutil.exe" OR Image="*\curl.exe" OR Image="*\wscript.exe" OR Image="*\cscript.exe") NOT (TargetFilename="*.pdf" OR TargetFilename="*.docx" OR TargetFilename="*.xlsx" OR TargetFilename="*.tmp") | table _time, host, user, Image, CommandLine